generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  email                 String    @id
  id                    String    @unique
  name                  String
  joiningDate           DateTime  @db.Date
  designation           String
  department             String
  employeeType          String
  managerEmail          String?
  probationEndDate      DateTime? @db.Date
  role                  String
  status                String
  fullTimeEffectiveDate DateTime? @db.Date
  gender                String?
  contractType          String
  // Notice-period end date, sheet-synced from the "lastday" column. Set
  // means the employee has resigned and is serving notice - see
  // getAvailableLeaveTypes()/validateLeaveRequest() in leave-calculator.ts,
  // which block Casual Leave entirely once this is set (any date, not just
  // a past one - presence alone is the policy trigger).
  lastDay               DateTime? @db.Date
  // Admin-granted exception letting this specific employee select Annual
  // Leave while still on probation (normally blocked entirely) - never
  // sheet-synced, see upsertEmployeesFromSheet in db.ts.
  probationAnnualLeaveApproved Boolean @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  manager         Employee?        @relation("ManagerReportees", fields: [managerEmail], references: [email])
  reportees       Employee[]       @relation("ManagerReportees")
  leaves          Leave[]
  openingBalance  OpeningBalance?
  balanceSnapshot BalanceSnapshot?
  notifications   Notification[]
  compOffCredits  CompOffCredit[]

  @@index([managerEmail])
  @@index([status])
  @@index([role])
}

model Leave {
  id                 String    @id
  employeeEmail      String
  employeeName       String
  leaveType          String
  startDate          DateTime  @db.Date
  endDate            DateTime  @db.Date
  days               Decimal   @db.Decimal(5, 1)
  daysByYear         Json      @default("{}")
  halfDayPeriod      String?
  extraWorkStartDate DateTime? @db.Date
  extraWorkEndDate   DateTime? @db.Date
  reason             String
  status             String    @default("pending")
  appliedOn          DateTime  @default(now())
  reviewedBy         String    @default("")
  reviewedOn         String    @default("")
  reviewerComments   String    @default("")
  rejectedByRole     String?
  createdAt          DateTime  @default(now())

  employee      Employee       @relation(fields: [employeeEmail], references: [email])
  comments      LeaveComment[]
  internalNotes InternalNote[]
  notifications Notification[]

  @@index([employeeEmail, appliedOn(sort: Desc)])
  @@index([status, appliedOn(sort: Desc)])
  @@index([status, endDate, startDate])
  @@index([employeeEmail, status])
}

model LeaveComment {
  id          String   @id
  leaveId     String
  authorEmail String
  authorName  String
  comment     String
  createdAt   DateTime @default(now())

  leave Leave @relation(fields: [leaveId], references: [id], onDelete: Cascade)

  @@index([leaveId, createdAt(sort: Asc)])
}

model InternalNote {
  id          String   @id
  leaveId     String
  authorEmail String
  authorName  String
  comment     String
  createdAt   DateTime @default(now())

  leave Leave @relation(fields: [leaveId], references: [id], onDelete: Cascade)

  @@index([leaveId, createdAt(sort: Asc)])
}

model Holiday {
  date DateTime @id @db.Date
  name String
}

// A Friday/Saturday (the normal company weekend) that's a working day for a
// specific date - e.g. a team came in to make up for a holiday landing
// mid-week. Just a date list, mirroring Holiday but inverted: presence here
// overrides the default weekend exclusion in leave-calculator.ts.
model WorkingWeekend {
  date DateTime @id @db.Date
}

model OpeningBalance {
  email         String   @id
  sick          Decimal? @db.Decimal(5, 1)
  casual        Decimal? @db.Decimal(5, 1)
  annual        Decimal? @db.Decimal(5, 1)
  marriage      Decimal? @db.Decimal(5, 1)
  maternity     Decimal? @db.Decimal(5, 1)
  paternity     Decimal? @db.Decimal(5, 1)
  ladiesWfh     Decimal? @db.Decimal(5, 1)
  compassionate Decimal? @db.Decimal(5, 1)
  compensatory  Decimal? @db.Decimal(5, 1)
  wfh           Decimal? @db.Decimal(5, 1)
  unpaid        Decimal? @db.Decimal(5, 1)
  updatedAt     DateTime @default(now())

  employee Employee @relation(fields: [email], references: [email])
}

model BalanceSnapshot {
  email          String   @id
  casualEntitled Decimal? @db.Decimal(5, 1)
  casualTaken    Decimal? @db.Decimal(5, 1)
  casualBalance  Decimal? @db.Decimal(5, 1)
  sickEntitled   Decimal? @db.Decimal(5, 1)
  sickTaken      Decimal? @db.Decimal(5, 1)
  sickBalance    Decimal? @db.Decimal(5, 1)
  annualEntitled Decimal? @db.Decimal(5, 1)
  annualTaken    Decimal? @db.Decimal(5, 1)
  annualBalance  Decimal? @db.Decimal(5, 1)
  importedAt     DateTime @default(now())

  employee Employee @relation(fields: [email], references: [email])
}

// Singleton row (id is always "admin") caching the admin Team Details
// balances table's expensive per-employee computation - see
// computeAllEmployeeBalances()/refreshEmployeeBalanceCache() in db.ts.
// Refreshed nightly by a Vercel Cron and on-demand via the Admin page's
// Refresh button; never touched for the employee/manager views, which stay
// live.
model EmployeeBalanceCache {
  id         String   @id @default("admin")
  data       Json
  computedAt DateTime @default(now())
}

// Singleton row caching the full active-employee roster (getEmployees()) for
// the Admin Team Details listing - refreshed by sheet sync (manual button +
// cron, every ~15 days) and by the two direct admin edits that bypass sync
// (updateEmployeeRole, setProbationAnnualLeaveApproval), so an admin's own
// change is reflected immediately rather than waiting for the next sync.
model RosterCache {
  id         String   @id @default("admin")
  data       Json
  computedAt DateTime @default(now())
}

// Singleton row caching every employee's getAvailableLeaveTypes() result
// (the Apply page's Leave Type dropdown), keyed by email - same refresh
// triggers as RosterCache above. A stale entry can only ever offer a choice
// that validateLeaveRequest() then rejects on submit, never let one slip
// through, so infrequent refresh is safe.
model AvailableLeaveTypesCache {
  id         String   @id @default("admin")
  data       Json
  computedAt DateTime @default(now())
}

model Notification {
  id                String   @id
  recipientEmail    String
  // Null for notifications that aren't about a leave request at all - i.e.
  // the Compensatory Off credit kinds below, which point at creditId
  // instead. Every "comment" notification still carries a leaveId.
  leaveId           String?
  // "comment" (a comment, internal note or submission on a leave - the
  // original and still the default), "comp_off_request" (an employee
  // recorded an additional work day, sent to their manager + admins) or
  // "comp_off_decision" (that request was accepted/rejected, sent back to
  // the employee). See src/lib/comp-off.ts.
  kind              String   @default("comment")
  creditId          String?
  leaveType         String
  employeeName      String
  commentAuthorName String
  commentPreview    String
  isInternalNote    Boolean  @default(false)
  isSubmission      Boolean  @default(false)
  read              Boolean  @default(false)
  createdAt         DateTime @default(now())

  recipient Employee       @relation(fields: [recipientEmail], references: [email])
  leave     Leave?         @relation(fields: [leaveId], references: [id], onDelete: Cascade)
  credit    CompOffCredit? @relation(fields: [creditId], references: [id], onDelete: Cascade)

  @@index([recipientEmail, createdAt(sort: Desc)])
}

// One banked "additional work day" for Compensatory Off. An employee records
// one (status "pending"), their manager or an HR admin accepts it
// ("accepted") and it becomes spendable balance, or rejects it ("rejected")
// and nothing is added. `consumedDays` is filled in FIFO by work date when a
// balance-drawn compensatory leave is finally approved, so
// `days - consumedDays` is what's still available on this credit.
//
// This is deliberately separate from the older compensatory flow, where the
// employee names the worked date(s) on the leave application itself and the
// work date IS the entitlement (Leave.extraWorkStartDate/extraWorkEndDate).
// Both flows stay live; see src/lib/comp-off.ts for how they share the
// "a work date can never be used twice" rule.
model CompOffCredit {
  id               String   @id
  employeeEmail    String
  workDate         DateTime @db.Date
  days             Decimal  @db.Decimal(2, 1)
  reason           String
  status           String   @default("pending")
  consumedDays     Decimal  @default(0) @db.Decimal(3, 1)
  // "employee" (recorded in the portal) or "import" (loaded by HR from the
  // pre-portal spreadsheet, already accepted).
  source           String   @default("employee")
  reviewedBy       String   @default("")
  reviewedOn       String   @default("")
  reviewerComments String   @default("")
  createdAt        DateTime @default(now())

  employee      Employee       @relation(fields: [employeeEmail], references: [email])
  notifications Notification[]

  @@index([employeeEmail, status])
  @@index([employeeEmail, workDate])
}
